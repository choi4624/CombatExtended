<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- ==================== Ammo ========================== -->
	<!-- charged ammo and uncharged ammo are same base ammo. But Tech level is different. -->
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_RailgunKE_Base_Charged">
		<defName>Ammo_2x4mmRailgun_charged</defName>
		<label>2×4mm railgun KE-Charged</label>
		<statBases><Mass>0.008</Mass></statBases>
		<costList><Steel>20</Steel><Uranium>40</Uranium><Ammo_H2_Fuel_Cell>500</Ammo_H2_Fuel_Cell></costList>
	  </ThingDef>
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_RailgunKE_Base_Uncharged">
		<defName>Ammo_2x4mmRailgun_uncharged</defName>
		<label>2×4mm railgun KE-Uncharged</label>
		<statBases><Mass>0.003</Mass></statBases>
		<costList><Uranium>40</Uranium><Steel>20</Steel></costList>
	</ThingDef>

	<!-- ==================== AmmoSet ========================== -->
	<!-- Weapon's AmmoSet and Projectile are Same -->
	<CombatExtended.AmmoSetDef ParentName="AmmoSet_RailgunKE_Base_Uncharged">
		<defName>AmmoSet_2x4mmUncharged_M6_Railgun</defName>
		<label>2×4mm railgun (uncharged, Mach 6)</label>
		<ammoTypes Inherit="False">
		  <Ammo_2x4mmRailgun_Uncharged>Bullet_2x4mm_KE_M6_Railgun</Ammo_2x4mmRailgun_Uncharged>
		</ammoTypes>
	  </CombatExtended.AmmoSetDef>

	  <CombatExtended.AmmoSetDef ParentName="AmmoSet_RailgunKE_Base_Uncharged">
		<defName>AmmoSet_2x4mmUncharged_M8_Railgun</defName>
		<label>2×4mm railgun (uncharged, Mach 8)</label>
		<ammoTypes Inherit="False">
		  <Ammo_2x4mmRailgun_Uncharged>Bullet_2x4mm_KE_M8_Railgun</Ammo_2x4mmRailgun_Uncharged>
		</ammoTypes>
	  </CombatExtended.AmmoSetDef>
	  <CombatExtended.AmmoSetDef ParentName="AmmoSet_RailgunKE_Base_Charged">
		<defName>AmmoSet_2x4mmCharged_M6_Railgun</defName>
		<label>2×4mm railgun (charged, Mach 6)</label>
		<ammoTypes Inherit="False">
		  <Ammo_2x4mmRailgun_Charged>Bullet_2x4mm_KE_M6_Railgun</Ammo_2x4mmRailgun_Charged>
		</ammoTypes>
	  </CombatExtended.AmmoSetDef>
	  <CombatExtended.AmmoSetDef ParentName="AmmoSet_RailgunKE_Base_Charged">
		<defName>AmmoSet_2x4mmCharged_M8_Railgun</defName>
		<label>2×4mm railgun (charged, Mach 8)</label>
		<ammoTypes Inherit="False">
		  <Ammo_2x4mmRailgun_Charged>Bullet_2x4mm_KE_M8_Railgun</Ammo_2x4mmRailgun_Charged>
		</ammoTypes>
	  </CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_RailgunKE_Base_Charged">
		<defName>Ammo_2x4mmRailgun_Charged</defName>
		<label>2x4mm Railgun (KE-Charged)</label>
		<statBases>
			<Mass>0.008</Mass>
			<Bulk>0.008</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
			<!-- Railgun ammo isn't handloaded because it contains no propellant, and the sabots must be precision-machined anyway -->
		</tradeTags>
		<graphicData>
			<texPath>Things/Ammo/Railgun/Rifle</texPath>
			<graphicClass>CombatExtended.Graphic_StackCountRanged</graphicClass>
		</graphicData>
	</ThingDef>
	<ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_RailgunKE_Base_Uncharged">
		<defName>Ammo_2x4mmRailgun_Uncharged</defName>
		<label>2x4mm Railgun (KE-Uncharged)</label>
		<statBases>
			<Mass>0.003</Mass>
			<Bulk>0.003</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
			<!-- Railgun ammo isn't handloaded because it contains no propellant, and the sabots must be precision-machined anyway -->
		</tradeTags>
		<graphicData>
			<texPath>Things/Ammo/Railgun/Rifle</texPath>
			<graphicClass>CombatExtended.Graphic_StackCountRanged</graphicClass>
		</graphicData>
	</ThingDef>
	<!-- ================== Projectiles ================== -->
	<ThingDef ParentName="Proj_RailgunKE_Base">
		<defName>Bullet_2x4mm_KE_M6_Railgun</defName>
		<label>2×4mm KE (M6)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
		  <damageAmountBase>6</damageAmountBase>
		  <armorPenetrationSharp>20</armorPenetrationSharp>
		  <speed>300</speed>
		</projectile>
	  </ThingDef>
	  <ThingDef ParentName="Proj_RailgunKE_Base">
		<defName>Bullet_2x4mm_KE_M8_Railgun</defName>
		<label>2×4mm KE (M8)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
		  <damageAmountBase>6</damageAmountBase>
		  <armorPenetrationSharp>26</armorPenetrationSharp>
		  <speed>340</speed>
		</projectile>
	  </ThingDef>
	<!-- ==================== Recipes ========================== -->
	<RecipeDef ParentName="ChargeAmmoRecipeBase">
		<defName>MakeAmmo_2x4mmRailgun_KE_Charged</defName>
		<label>make 2x4mm Railgun KE-Charged x500</label>
		<description>Craft 500 2x4mm Railgun KE-Charged cartridges.</description>
		<jobString>Making 2x4mm Railgun KE-Charged cartridges.</jobString>
		<workAmount>8000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>40</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Ammo_H2_Fuel_Cell</li>
					</thingDefs>
				</filter>
				<count>500</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Uranium</li>
				<li>Ammo_H2_Fuel_Cell</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_2x4mmRailgun_Charged>500</Ammo_2x4mmRailgun_Charged>
		</products>
	</RecipeDef>
	<RecipeDef ParentName="ChargeAmmoRecipeBase">
		<defName>MakeAmmo_2x4mmRailgun_KE_Uncharged</defName>
		<label>make 2x4mm Railgun KE-Uncharged x500</label>
		<description>Craft 500 2x4mm Railgun KE-Uncharged cartridges.</description>
		<jobString>Making 2x4mm Railgun KE-Uncharged cartridges.</jobString>
		<workAmount>8000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>40</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Uranium</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_2x4mmRailgun_Uncharged>500</Ammo_2x4mmRailgun_Uncharged>
		</products>
	</RecipeDef>
</Defs>