<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BaseBulletCE" Abstract="True" Name="Proj_RailgunKE_Base">
        <graphicData>
          <texPath>Things/Projectile/Bullet_Small</texPath>
          <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile Class="CombatExtended.ProjectilePropertiesCE">
          <damageDef>Bullet</damageDef>
          <!-- damage/AP/speed are set in the child defs -->
          <!-- In Gameplay, speed is faster than normal bullet. -->
          <damageAmountBase>10.00</damageAmountBase>
          <armorPenetrationSharp>10.00</armorPenetrationSharp>
          <armorPenetrationBlunt>10.00</armorPenetrationBlunt>
          <speed>300</speed>
          <!-- stoppingPower is similar with normal bullet. -->
          <stoppingPower>0.55</stoppingPower>
        </projectile>
      </ThingDef>
</Defs>
