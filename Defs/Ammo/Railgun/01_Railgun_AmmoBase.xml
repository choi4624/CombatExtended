    <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerAmmoBase" Abstract="True" Name="Ammo_RailgunKE_Base">
        <label>railgun KE (base)</label>
        <description>Electromagnetically-launched Railgun projectile.</description>
        <statBases>
            <!-- Mass and Bulk are set in the child defs -->
            <Mass>0.004</Mass>
            <Bulk>0.01</Bulk>
        </statBases>
        <thingCategories>
          <li>AmmoRailgun</li>
        </thingCategories>
        <tradeTags>
            <li>CE_AutoEnableTrade</li>
            <li>CE_AutoEnableCrafting_FabricationBench</li>
          </tradeTags>
        <graphicData>
          <texPath>Things/Ammo/Railgun/Rifle</texPath>
          <graphicClass>CombatExtended.Graphic_StackCountRanged</graphicClass>
        </graphicData>
        <!-- For backward compatibility, ammoClass Def is Describe as 'sabot' -->
        <!--check Defs\Ammo\AmmoCategoryDefs\AmmoCategories_Advanced.xml -->
        <ammoClass>RailgunSabot</ammoClass>
        <stackLimit>500</stackLimit>
        <category>Item</category>
    </ThingDef>
    <ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_RailgunKE_Base" Abstract="True" Name="Ammo_RailgunKE_Base_Charged">
        <label>railgun KE charged (base)</label>
		<description>High-density penetrator alloy made from depleted depleted uranium and small amounts of steel. 
			Extremely dense and self-sharpening under impact, designed for railgun kinetic energy rounds. 
			\nFuel Cell Charged.</description>
    </ThingDef>
    <ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_RailgunKE_Base" Abstract="True" Name="Ammo_RailgunKE_Base_Uncharged">
        <label>railgun KE uncharged (base)</label>
		<description>High-density penetrator alloy made from depleted uranium and small amounts of steel. 
			Extremely dense and self-sharpening under impact, designed for railgun kinetic energy rounds. 
			\nFuel Cell Uncharged.</description>
    </ThingDef>
</Defs>
