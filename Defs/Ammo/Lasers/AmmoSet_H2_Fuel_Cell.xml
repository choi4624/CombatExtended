<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===== ThingCategory (KR: 분류 정의 / EN: item category) ===== -->
  <ThingCategoryDef>
    <defName>AmmoCategory_H2_Fuel_Cell</defName>
    <label>H2 fuel cell</label>
    <parent>AmmoAdvanced</parent>
    <iconPath>UI/Icons/ThingCategories/CaliberPlasmaLarge</iconPath>
  </ThingCategoryDef>

  <!-- ===== Ammo (KR: 공용 H2 셀 1종 / EN: single shared ammo) ===== -->
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerAmmoBase">
    <defName>Ammo_H2_Fuel_Cell</defName>
    <label>H2 fuel cell</label>
    <!-- kr Description 
    우주 기술급 H2 + O2 연료전지로, 나노 저장 기술로 20,000 Wh/kg를 저장할 수 있습니다.
    에너지 기반 무기에 사용하거나, 레일건, 플라즈마, 이온 등 다른 고 에너지 기반 고급 무기 시스템에 사용되기도 합니다.

    다른 고 에너지 저장 재료와 다르게, 이 물질은 손상되어도 폭발하지 않으나, 손상이 발생하면 매우 빠르게 전체 셀 카트리지가 사용할 수 없게 됩니다.
    * 사용 후 증류수를 만들지만, 마시거나 또는 다른 용도로 사용하지 마세요. 그냥 버리세요.
    -->
    <description>
        A spacer-tech disposable H2+O2 fuel cell utilizing advanced nano-storage technology, capable of storing up to 20,000 Wh/kg. 
        Used as ammunition for energy weapons, it can also serve as a high-energy component for railgun, plasma, and ion systems.

        Unlike many high-energy materials, it does not explode when damaged, but damage will quickly render the entire cartridge unusable.
        * Produces distilled water as a byproduct after use. Not intended for consumption or reuse — dispose properly.
    </description>
    <ammoClass>Laser</ammoClass> <!-- Projectile define RealDamage -->
    <statBases>
      <Mass>0.0035</Mass>  <!-- 3.5 g/ea -->
      <Bulk>0.003</Bulk>
      <MaxHitPoints>20</MaxHitPoints>  <!-- fragile so it breaks quickly -->
      <Flammability>0.2</Flammability> <!-- burns away instead of cooking off -->
      <DeteriorationRate>0.05</DeteriorationRate> <!-- natural deterioration rate is low -->
    </statBases>
    <stackLimit>5000</stackLimit>
    <thingCategories>
      <li>AmmoCategory_H2_Fuel_Cell</li>
    </thingCategories>
  </ThingDef>

  <!-- ===== AmmoSet (KR: 같은 Ammo → 다른 탄도 / EN: same ammo → different projectile) ===== -->
  <CombatExtended.AmmoSetDef>
    <defName>AmmoSet_Laser_Rifle_H2</defName>
    <label>H2 fuel cell (rifle)</label>
    <ammoTypes>
      <Ammo_H2_Fuel_Cell>Proj_H2_Fuel_Cell_Rifle</Ammo_H2_Fuel_Cell>
    </ammoTypes>
  </CombatExtended.AmmoSetDef>

  <CombatExtended.AmmoSetDef>
    <defName>AmmoSet_Laser_Heavy_H2</defName>
    <label>H2 fuel cell (heavy)</label>
    <ammoTypes>
      <Ammo_H2_Fuel_Cell>Proj_H2_Fuel_Cell_Heavy</Ammo_H2_Fuel_Cell>
    </ammoTypes>
  </CombatExtended.AmmoSetDef>

  <!-- ===== Projectile base (KR: 공용 베이스 / EN: shared base) ===== -->
<ThingDef Name="Proj_H2_Fuel_Cell_Base" ParentName="BaseBulletCE" Abstract="True">
    <graphicData>
      <texPath>Things/Projectile/Charged/ChargeLanceShot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <speed>600</speed>
      <!-- KR: 주 대미지는 '관통'으로 처리 / EN: do penetration as primary -->
      <damageDef>Bullet</damageDef>
    </projectile>
  </ThingDef>
  
  <!-- ===== Rifle profile: 현대 보병 수준의 교전 능력 / Small puncture + laser burn ===== -->
  <ThingDef ParentName="Proj_H2_Fuel_Cell_Base">
    <defName>Proj_H2_Fuel_Cell_Rifle</defName>
    <label>H2 fuel cell rifle beam</label>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <!-- KR: 작은 관통 상처 / EN: small puncture -->
      <damageAmountBase>8</damageAmountBase>
      <armorPenetrationSharp>22</armorPenetrationSharp>
      <armorPenetrationBlunt>0.05</armorPenetrationBlunt>
      <stoppingPower>0.05</stoppingPower>
      <suppressionFactor>0.07</suppressionFactor>
  
      <!-- KR: 추가 레이저 화상 / EN: extra laser burn -->
      <secondaryDamage>
        <li>
          <def>CE_Laser</def>
          <amount>14</amount>
        </li>
        <!-- 화상 피해를 추가하고자 한다면 추가 / if you want to add flame damage, add it here
        <li>
          <def>Flame</def>
          <amount>2</amount>
        </li> -->
      </secondaryDamage>
    </projectile>
  </ThingDef>
  

  <!-- 
    important: This projectile type consider can use 3 or more cells in one shot. This can be defined in Each weaponDef.
    If shot single cell is not a problem, but it is important to consider balence of maintaince and cost. Increase MagazineSize is a good idea.
  -->

    <!-- ===== Squad Support profile: 제한된 장갑 표적에 대한 대응, 화력 지원무기 / Deeper pen + larger burn ===== -->
    <ThingDef ParentName="Proj_H2_Fuel_Cell_Base">
        <defName>Proj_H2_Fuel_Cell_Squad_Support</defName>
        <label>H2 fuel cell squad support beam</label>
        <projectile Class="CombatExtended.ProjectilePropertiesCE">
          <damageAmountBase>12</damageAmountBase>
          <armorPenetrationSharp>44</armorPenetrationSharp>
          <armorPenetrationBlunt>0.05</armorPenetrationBlunt>
          <stoppingPower>0.08</stoppingPower>
          <suppressionFactor>0.15</suppressionFactor>
      
          <secondaryDamage>
            <li>
              <def>CE_Laser</def>
              <amount>44</amount>
            </li>
          </secondaryDamage>
        </projectile>
      </ThingDef>
      

  <!-- 
    important: This projectile type consider can use 25 or more cells in one shot. This can be defined in Each weaponDef.
    If shot single cell is not a problem, but it is important to consider balence of maintaince and cost. Increase MagazineSize is a good idea.
  -->

  <!-- ===== Anti-Materiel profile: 대 차량, 중장갑 대상 / Deeper pen + larger burn ===== -->
  <ThingDef ParentName="Proj_H2_Fuel_Cell_Base">
    <defName>Proj_H2_Fuel_Cell_Anti_Materiel</defName>
    <label>H2 fuel cell anti-materiel beam</label>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageAmountBase>180</damageAmountBase>
      <armorPenetrationSharp>225</armorPenetrationSharp>
      <armorPenetrationBlunt>0.05</armorPenetrationBlunt>
      <stoppingPower>1.5</stoppingPower>
      <suppressionFactor>1</suppressionFactor>
  
      <secondaryDamage>
        <li>
          <def>CE_Laser</def>
          <amount>382</amount>
        </li>
      </secondaryDamage>
    </projectile>
  </ThingDef>

  <!-- ===== Recipe (KR: 공용 셀 생산 하나만 / EN: single recipe for common cell) ===== -->
  <RecipeDef ParentName="AmmoRecipeBase">
    <defName>MakeAmmo_H2_Fuel_Cell</defName>
    <label>make H2 fuel cell x1000</label>
    <description>Craft 1000 H2 fuel cells.</description>
    <jobString>Making H2 fuel cells.</jobString>
    <ingredients>
      <li>
        <filter><thingDefs><li>Chemfuel</li></thingDefs></filter>
        <count>1000</count>
      </li>
      <li>
        <filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Chemfuel</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Ammo_H2_Fuel_Cell>1000</Ammo_H2_Fuel_Cell>
    </products>
    <workAmount>12000</workAmount>
  </RecipeDef>

</Defs>
